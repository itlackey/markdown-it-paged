  {
    "line": 1,
    "marker": {
      "__line": 1,
      "attrs": {},
      "kind": "section",
      "name": "intro",
    },
    "message": "@section used without an open @page; creating an implicit page wrapper (data-page="auto").",
    "type": "implicit_page",
  },
]
`;

exports[`markdown-it-paged > supports space-delimited class lists on markers 1`] = `
