exports[`markdown-it-paged > @end-section closes an open section region mid-page 1`] = `
"<div class="page" data-page="p1"><div class="section" data-section="two-column"><p>Left column content.</p>
</div><p>Single column content after section.</p>
"
`;

exports[`markdown-it-paged > @end-section closes an open section region mid-page 2`] = `[]`;

exports[`markdown-it-paged > @end-section with no open section is a no-op (no extra divs emitted) 1`] = `
"<div class="page" data-page="p1"><p>Some content.</p>
<p>More content.</p>
"
`;

exports[`markdown-it-paged > @end-section with no open section is a no-op (no extra divs emitted) 2`] = `[]`;

exports[`markdown-it-paged > adhoc spread + break wraps only the marked region 1`] = `
"<p>Before.</p>
<div class="spread fullbleed" data-spread="s1"><p>Inside spread.</p>
<p>After.</p>
</div>"
`;

exports[`markdown-it-paged > adhoc spread + break wraps only the marked region 2`] = `
[
  {
    "line": 0,
    "marker": null,
    "message": "An open @spread reached end-of-document; closing it automatically. If this was meant to be adhoc, consider adding @break to return to default flow.",
    "type": "spread_eof_close",
  },
]
`;

exports[`markdown-it-paged > break closes nearest scope (section then page then spread) 1`] = `
"<div class="spread" data-spread="s"><div class="page" data-page="p"><div class="section" data-section="a"><p>A</p>
</div><p>B</p>
<p>C</p>
<p>D</p>
</div></div>"
`;

exports[`markdown-it-paged > break closes nearest scope (section then page then spread) 2`] = `[]`;

exports[`markdown-it-paged > content after @end-section within the same @page renders outside any region div 1`] = `
"<div class="page" data-page="p1"><div class="section two-column"><p>Inside two-column.</p>
</div><p>Outside two-column.</p>
"
`;

exports[`markdown-it-paged > content after @end-section within the same @page renders outside any region div 2`] = `[]`;

exports[`markdown-it-paged > does nothing when no markers are used (opt-in) 1`] = `
"<h1>Title</h1>
<p>This is normal markdown.</p>
"
`;

exports[`markdown-it-paged > does nothing when no markers are used (opt-in) 2`] = `[]`;

exports[`markdown-it-paged > explicit spread + pages + sections 1`] = `
"<div class="spread" data-spread="ch1" data-template="spread"><div class="page" data-page="left" data-template="spread-left"><div class="section hero" data-section="hero" data-region="left"><h1>Hello</h1>
<p>Text</p>
</div></div><div class="page" data-page="right" data-template="spread-right"><div class="section" data-section="body" data-region="right"><p>More</p>
</div></div></div>"
`;

